jira.Filter Approved__EGODEMO_@sjk {
  name = "Approved (EGODEMO)"
  jql = "${ jira.Field.instance.Project__project } = ${ jira.Project.instance.Eshed_Demo_Proj } and ${ jira.Field.instance.Status__status } = \"${ jira.Status.instance.approved.name }\" ORDER BY ${ jira.Field.instance.Updated__datetime } desc"
  owner = {
    id = "salto"
  }
  sharePermissions = [
    {
      type = "project"
      project = {
        id = jira.Project.instance.Eshed_Demo_Proj
      }
    },
  ]
}
