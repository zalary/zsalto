jira.Filter Filter_for_PROJ_board@s {
  name = "Filter for PROJ board"
  jql = "${ jira.Field.instance.Project__project } = PROJ ORDER BY ${ jira.Field.instance.Epic_Status__gh_epic_status__c@suubbuu.name } ASC"
  owner = {
    id = "salto"
  }
  sharePermissions = [
    {
      type = "project"
      project = {
        id = jira.Project.instance.project
      }
    },
  ]
}
