        compareFieldValue = {
          type = "NAME"
          multiValue = true
          values = [
            jira.Status.instance.resolved.name,
          ]
        }
      }
      children = [
      ]
      conditions = [
      ]
      optimisedIds = [
      ]
      newComponent = false
    },
    {
      component = "ACTION"
      type = "jira.issue.assign"
      value = {
        excludedUsers = [
