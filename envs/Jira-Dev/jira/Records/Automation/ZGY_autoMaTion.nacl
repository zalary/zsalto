jira.Automation ZGY_autoMaTion {
  name = "ZGY_autoMaTion"
  state = "ENABLED"
  canOtherRuleTrigger = false
  notifyOnError = "FIRSTERROR"
  authorAccountId = {
    id = "salto"
  }
  actorAccountId = {
    id = "salto"
  }
  trigger = {
    component = "TRIGGER"
    type = "jira.issue.field.changed"
    value = {
      synchronous = false
      fields = [
        {
          value = jira.Field.instance.Labels__array
          type = "field"
        },
      ]
      actions = [
        "create",
      ]
    }
    children = [
    ]
    conditions = [
    ]
    optimisedIds = [
    ]
    newComponent = false
  }
  components = [
    {
      component = "ACTION"
      type = "jira.issue.assign"
      value = {
        excludedUsers = [
        ]
        assignee = {
          type = "SMART"
          value = "{{initiator}}"
        }
        assignType = "SPECIFY_USER"
      }
      children = [
      ]
      conditions = [
      ]
      optimisedIds = [
      ]
      newComponent = false
    },
  ]
  labels = [
  ]
  _alias = "ZGY_autoMaTion"
}
