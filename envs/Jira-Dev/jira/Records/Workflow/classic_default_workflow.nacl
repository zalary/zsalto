      location = {
        x = 1709
        y = 97
      }
    },
  ]
  transitions = {
    Create_Issue__From__none__Initial@sfffsff = {
      name = "Create Issue"
      description = ""
      to = jira.Status.instance.open
      type = "initial"
      rules = {
        postFunctions = [
          {
            type = "com.atlassian.jira.workflow.function.issue.IssueCreateFunction"
          },
          {
            type = "com.atlassian.jira.workflow.function.event.FireIssueEventFunction"
            configuration = {
              event = {
                id = jira.IssueEvent.instance.Issue_Created@s
              }
            }
          },
        ]
        validators = [
          {
            type = "com.atlassian.jira.workflow.validator.PermissionValidator"
            configuration = {
              permission = "Create Issue"
            }
          },
        ]
      }
      properties = [
        {
          key = "jira.i18n.title"
          value = "common.forms.create"
        },
        {
          key = "opsbar-sequence"
          value = "0"
        },
      ]
    }
    Close_Issue__From__In_Progress_Open_Reopened__Directed@sfffsszdzdff = {
      name = "Close Issue"
      description = ""
      from = [
        {
          id = jira.Status.instance.in_progress@s
        },
        {
          id = jira.Status.instance.open
        },
        {
          id = jira.Status.instance.reopened
        },
      ]
      to = jira.Status.instance.closed
      type = "common"
      rules = {
        postFunctions = [
          {
            type = "com.atlassian.jira.workflow.function.issue.UpdateIssueStatusFunction"
          },
          {
            type = "com.atlassian.jira.workflow.function.misc.CreateCommentFunction"
          },
          {
            type = "com.atlassian.jira.workflow.function.issue.GenerateChangeHistoryFunction"
          },
          {
            type = "com.atlassian.jira.workflow.function.issue.IssueReindexFunction"
          },
          {
            type = "com.atlassian.jira.workflow.function.event.FireIssueEventFunction"
            configuration = {
              event = {
                id = jira.IssueEvent.instance.Issue_Closed@s
              }
            }
          },
        ]
        conditions = {
          operator = "AND"
          conditions = [
            {
              type = "com.atlassian.jira.workflow.condition.PermissionCondition"
              configuration = {
                permission = "Resolve Issue"
              }
            },
            {
              type = "com.atlassian.jira.workflow.condition.PermissionCondition"
              configuration = {
                permission = "Close Issue"
              }
            },
          ]
        }
      }
      properties = [
        {
          key = "jira.i18n.description"
          value = "closeissue.desc"
        },
        {
          key = "jira.i18n.submit"
          value = "closeissue.close"
        },
        {
          key = "jira.i18n.title"
          value = "closeissue.title"
        },
        {
          key = "opsbar-sequence"
          value = "60"
        },
      ]
    }
    Reopen_Issue__From__Closed_Resolved__Directed@sfffszdff = {
      name = "Reopen Issue"
      description = ""
      from = [
        {
