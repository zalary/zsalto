jira.Workflow IDO8__Simple_Issue_Tracking_Workflow@fssss {
  description = ""
  statuses = [
    {
      id = jira.Status.instance.done
      name = "Done"
      location = {
        x = 1518
        y = 354
      }
    },
    {
      id = jira.Status.instance.in_progress@s
      name = "In Progress"
      location = {
        x = 1927
        y = 215
      }
    },
    {
      id = jira.Status.instance.to_do@s
      name = "To Do"
      location = {
        x = 1512
        y = 80
      }
    },
  ]
  transitions = {
    Create__From__none__Initial@fffsff = {
      name = "Create"
      description = ""
      to = jira.Status.instance.to_do@s
      type = "initial"
      rules = {
        postFunctions = [
          {
            type = "com.atlassian.jira.workflow.function.issue.IssueCreateFunction"
          },
          {
            type = "com.atlassian.jira.workflow.function.issue.IssueReindexFunction"
          },
          {
            type = "com.atlassian.jira.workflow.function.event.FireIssueEventFunction"
            configuration = {
              event = {
                id = jira.IssueEvent.instance.Issue_Created@s
              }
            }
          },
        ]
        validators = [
          {
            type = "com.atlassian.jira.workflow.validator.PermissionValidator"
            configuration = {
              permission = "Create Issue"
            }
          },
        ]
      }
      properties = [
        {
          key = "jira.i18n.submit"
          value = "common.forms.create"
        },
        {
          key = "jira.i18n.title"
          value = "common.forms.create"
        },
      ]
    }
