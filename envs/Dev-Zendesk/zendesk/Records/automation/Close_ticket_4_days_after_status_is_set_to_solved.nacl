zendesk.automation Close_ticket_4_days_after_status_is_set_to_solved@s {
  title = "Cerrar el ticket 4 días después de que el estado se haya definido como resuelto"
  active = true
  default = true
  actions = [
    {
      field = "status"
      value = "closed"
    },
  ]
  conditions = {
    all = [
      {
        field = "status"
        operator = "is"
        value = "solved"
      },
      {
        field = "SOLVED"
        operator = "greater_than"
        value = "96"
      },
    ]
  }
  raw_title = "Cerrar el ticket 4 días después de que el estado se haya definido como resuelto"
  _alias = "Cerrar el ticket 4 días después de que el estado se haya definido como resuelto"
}
