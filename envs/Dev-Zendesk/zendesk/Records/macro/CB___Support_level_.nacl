zendesk.macro CB___Support_level_@sbsss {
  title = "CB - Support level "
  active = true
  default = false
  description = ""
  actions = [
    {
      field = zendesk.ticket_field.instance.CB___Support_Level_tagger@sbssu
      value = zendesk.ticket_field__custom_field_options.instance.CB___Support_Level_tagger__support_gold@sbssuuuu
    },
    {
      field = "comment_value_html"
      value = "<p>Updated the ticket's support level based on the rules in {{ticket.ticket_field_${ zendesk.ticket_field.instance.CB___Support_Level_tagger@sbssu }}}</p>"
    },
  ]
  raw_title = "CB - Support level "
  _alias = "CB - Support level "
}
