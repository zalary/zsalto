zendesk.macro Customer_not_responding@s {
  title = "Cliente no responde"
  active = true
  default = false
  actions = [
    {
      field = "status"
      value = "pending"
    },
    {
      field = "comment_value"
      value = "Hola, {{ticket.requester.name}}. Nuestro agente {{current_user.name}} ha intentado comunicarse con usted sobre esta solicitud, pero no hemos sabido nada de parte suya. Le agradecemos nos indique si podemos proporcionarle más asistencia. Gracias. "
    },
  ]
  raw_title = "Cliente no responde"
  _alias = "Cliente no responde"
}
