zendesk.macro Downgrade_and_inform@s {
  title = "Reducir prioridad e informar"
  active = true
  default = false
  actions = [
    {
      field = "priority"
      value = "low"
    },
    {
      field = "comment_value"
      value = "En este momento tenemos un nivel de tráfico más alto que de costumbre. Nos comunicaremos con usted lo antes posible."
    },
  ]
  raw_title = "Reducir prioridad e informar"
  _alias = "Reducir prioridad e informar"
}
