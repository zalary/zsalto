zendesk.macro SRD___Test_Macro_V2@sbsss {
  title = "SRD - Test Macro V2"
  active = true
  default = false
  actions = [
    {
      field = "comment_value_html"
      value = "<p>Hi {{ticket.requester.first_name}}​,</p><p><br></p><p>Thank you for your interest in Dark Mode! Before we enable it in your account, could you let us know more about how you plan to use dark mode? And which of your users will need access to this feature? Thank you.</p>"
    },
    {
      field = "current_tags"
      value = [
        zendesk.tag.instance.product_access_request_dark_mode@uufu,
      ]
    },
    {
      field = zendesk.ticket_field.instance.SRD___Early_Product_Access_Type_tagger@sbssssu
      value = zendesk.ticket_field__custom_field_options.instance.SRD___Early_Product_Access_Type_tagger__dark_mode@sbssssuuuu
    },
  ]
  raw_title = "SRD - Test Macro V2"
  _alias = "SRD - Test Macro V2"
}
