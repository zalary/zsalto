zendesk.macro SRD___Feature_request_2_0___1@sbsssvsbs {
  title = "SRD - Feature request 2.0 - 1"
  active = true
  default = false
  description = "A description, edited"
  actions = [
    {
      field = "priority"
      value = "urgent"
    },
    {
      field = "status"
      value = "open"
    },
    {
      field = "ticket_form_id"
      value = zendesk.ticket_form.instance.SRD___Enable_new_feature@sbsss
    },
    {
      field = "comment_value_html"
      value = "<p>{{${ zendesk.dynamic_content_item.instance.SRD___Greeting@sbs }}} {{ticket.requester.first_name}}​, thank you for submitting your request.</p><p>&nbsp;</p><p>Please visit <a href=\"https://www.salto.io/blogblog\">https://www.salto.io/blogblog</a> for more info</p>"
    },
  ]
  raw_title = "SRD - Feature request 2.0 - 1"
  _alias = "SRD - Feature request 2.0 - 1"
}
