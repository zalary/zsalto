zendesk.trigger Notify_requester_and_CCs_of_comment_update@s {
  title = "Notificar al solicitante y a los destinatarios de copias (CC) sobre la actualización de los comentarios"
  active = true
  default = false
  actions = [
    {
      field = "notification_user"
      value = [
        "requester_and_ccs",
        "[{{ticket.account}}] Asunto: {{ticket.title}}",
        '''
Su solicitud ({{ticket.id}}) ha sido actualizada. Para agregar comentarios adicionales, responda a este correo electrónico o utilice el vínculo a continuación:
{{ticket.link}}

{{ticket.comments_formatted}}
''',
      ]
    },
  ]
  conditions = {
    all = [
      {
        field = "update_type"
        operator = "is"
        value = "Change"
      },
      {
        field = "comment_is_public"
        operator = "is"
        value = true
      },
    ]
  }
  raw_title = "Notificar al solicitante y a los destinatarios de copias (CC) sobre la actualización de los comentarios"
  category_id = zendesk.trigger_category.instance.Notifications
  _alias = "Notificar al solicitante y a los destinatarios de copias (CC) sobre la actualización de los comentarios"
}
