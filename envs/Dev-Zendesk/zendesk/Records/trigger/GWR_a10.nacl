zendesk.trigger GWR_a10@s {
  title = "GWR a10"
  active = false
  default = false
  actions = [
    {
      field = "set_tags"
      value = [
        zendesk.tag.instance.a10,
      ]
    },
  ]
  conditions = {
    all = [
      {
        field = "status"
        operator = "is"
        value = "new"
      },
      {
        field = "assignee_id"
        operator = "is"
        value = "geoffrey.routledge@salto.io"
      },
    ]
  }
  description = "a10 Trigger"
  raw_title = "GWR a10"
  category_id = zendesk.trigger_category.instance.Notifications
  _alias = "GWR a10"
}
