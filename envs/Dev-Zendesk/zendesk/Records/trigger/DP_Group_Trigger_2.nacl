zendesk.trigger DP_Group_Trigger_2@s {
  title = "DP Group Trigger 2"
  active = true
  default = false
  actions = [
    {
      field = "set_tags"
      value = [
        zendesk.tag.instance.dp_test,
      ]
    },
  ]
  conditions = {
    any = [
      {
        field = "group_id"
        operator = "is"
        value = zendesk.group.instance.DP_Group_1@s
      },
    ]
  }
  description = ""
  raw_title = "DP Group Trigger 2"
  category_id = zendesk.trigger_category.instance.DP
  _alias = "DP Group Trigger 2"
}
