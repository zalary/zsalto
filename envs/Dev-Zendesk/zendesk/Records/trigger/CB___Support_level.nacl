zendesk.trigger CB___Support_level@sbss {
  title = "CB - Support level"
  active = true
  default = false
  actions = [
    {
      field = zendesk.ticket_field.instance.CB___Support_Level_tagger@sbssu
      value = zendesk.ticket_field__custom_field_options.instance.CB___Support_Level_tagger__support_gold@sbssuuuu
    },
  ]
  conditions = {
    all = [
      {
        field = zendesk.ticket_field.instance.Customer_Tier_multiselect@su
        operator = "includes"
        value = zendesk.ticket_field__custom_field_options.instance.Customer_Tier_multiselect__enterprise@suuu
      },
    ]
  }
  description = ""
  raw_title = "CB - Support level"
  category_id = zendesk.trigger_category.instance.CB
  _alias = "CB - Support level"
}
