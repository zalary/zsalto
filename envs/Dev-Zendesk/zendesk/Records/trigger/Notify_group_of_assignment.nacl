zendesk.trigger Notify_group_of_assignment@s {
  title = "Notificar al grupo sobre asignación"
  active = true
  default = false
  actions = [
    {
      field = "notification_group"
      value = [
        "group_id",
        "Asignación de [{{ticket.account}}] \"{{ticket.group.name}}\": {{ticket.title}}",
        '''
Este ticket (#{{ticket.id}}) ha sido asignado al grupo '{{ticket.group.name}}', al cual usted pertenece.

{{ticket.comments_formatted}}
''',
      ]
    },
  ]
  conditions = {
    all = [
      {
        field = "group_id"
        operator = "is_not"
        value = ""
      },
      {
        field = "assignee_id"
        operator = "is"
        value = ""
      },
    ]
    any = [
      {
        field = "group_id"
        operator = "changed"
        value = ""
      },
      {
        field = "assignee_id"
        operator = "changed"
        value = ""
      },
    ]
  }
  raw_title = "Notificar al grupo sobre asignación"
  category_id = zendesk.trigger_category.instance.Notifications
  _alias = "Notificar al grupo sobre asignación"
}
