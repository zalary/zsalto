zendesk.trigger Notify_assignee_of_reopened_ticket@s {
  title = "Notificar al agente asignado sobre ticket reabierto"
  active = true
  default = false
  actions = [
    {
      field = "notification_user"
      value = [
        "assignee_id",
        "[{{ticket.account}}] Re: {{ticket.title}}",
        '''
Se ha vuelto a abrir este ticket (n.° #{{ticket.id}}).

{{ticket.comments_formatted}}
''',
      ]
    },
  ]
  conditions = {
    all = [
      {
        field = "assignee_id"
        operator = "is_not"
        value = "current_user"
      },
      {
        field = "status"
        operator = "value_previous"
        value = "solved"
      },
      {
        field = "status"
        operator = "is_not"
        value = "closed"
      },
    ]
  }
  raw_title = "Notificar al agente asignado sobre ticket reabierto"
  category_id = zendesk.trigger_category.instance.Notifications
  _alias = "Notificar al agente asignado sobre ticket reabierto"
}
