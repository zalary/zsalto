zendesk.trigger CB___Trigger@sbs {
  title = "CB - Trigger"
  active = true
  default = false
  actions = [
    {
      field = "current_tags"
      value = [
        zendesk.tag.instance.cb_urgent_tag,
      ]
    },
    {
      field = zendesk.ticket_field.instance.CB___Severity_tagger@sbsu
      value = zendesk.ticket_field__custom_field_options.instance.CB___Severity_tagger__cb_sev_critical@sbsuuuuu
    },
  ]
  conditions = {
    all = [
      {
        field = "priority"
        operator = "is"
        value = "urgent"
      },
      {
        field = "ticket_due_date"
        operator = "is"
        value = "false"
      },
    ]
  }
  description = "A quick and simple trigger"
  raw_title = "CB - Trigger"
  category_id = zendesk.trigger_category.instance.CB
  _alias = "CB - Trigger"
}
