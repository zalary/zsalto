zendesk.trigger Notify_requester_of_new_proactive_ticket@s {
  title = "Notificar al solicitante sobre nuevo ticket proactivo"
  active = true
  default = false
  actions = [
    {
      field = "notification_user"
      value = [
        "requester_and_ccs",
        "{{ticket.title}}",
        '''
Este ticket fue creado en su nombre.

{{ticket.comments_formatted}}

Si desea agregar comentarios adicionales, responda a este correo electrónico.
''',
      ]
    },
  ]
  conditions = {
    all = [
      {
        field = "update_type"
        operator = "is"
        value = "Create"
      },
      {
        field = "ticket_is_public"
        operator = "is"
        value = "public"
      },
      {
        field = "role"
        operator = "is"
        value = "agent"
      },
    ]
  }
  description = "Un ticket proactivo es un ticket creado por un agente en nombre del solicitante."
  raw_title = "Notificar al solicitante sobre nuevo ticket proactivo"
  category_id = zendesk.trigger_category.instance.Notifications
  _alias = "Notificar al solicitante sobre nuevo ticket proactivo"
}
