zendesk.trigger Notify_assignee_of_assignment@s {
  title = "Notificar al agente asignado sobre asignación"
  active = true
  default = false
  actions = [
    {
      field = "notification_user"
      value = [
        "assignee_id",
        "Asignación de [{{ticket.account}}]: {{ticket.title}}",
        '''
Usted ha sido asignado a este ticket (n.° #{{ticket.id}}).

{{ticket.comments_formatted}}
''',
      ]
    },
  ]
  conditions = {
    all = [
      {
        field = "assignee_id"
        operator = "changed"
      },
      {
        field = "assignee_id"
        operator = "is_not"
        value = "current_user"
      },
    ]
  }
  raw_title = "Notificar al agente asignado sobre asignación"
  category_id = zendesk.trigger_category.instance.Notifications
  _alias = "Notificar al agente asignado sobre asignación"
}
