zendesk.trigger Notify_all_agents_of_received_request@s {
  title = "Notificar a todos los agentes sobre solicitud recibida"
  active = true
  default = false
  actions = [
    {
      field = "notification_user"
      value = [
        "all_agents",
        "[{{ticket.account}}] {{ticket.title}}",
        '''
Se ha recibido un ticket (n.° #{{ticket.id}}) de {{ticket.requester.name}}. Está sin asignar.

{{ticket.comments_formatted}}
''',
      ]
    },
  ]
  conditions = {
    all = [
      {
        field = "update_type"
        operator = "is"
        value = "Create"
      },
    ]
  }
  raw_title = "Notificar a todos los agentes sobre solicitud recibida"
  category_id = zendesk.trigger_category.instance.Notifications
  _alias = "Notificar a todos los agentes sobre solicitud recibida"
}
