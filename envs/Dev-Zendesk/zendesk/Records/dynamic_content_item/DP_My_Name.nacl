zendesk.dynamic_content_item dp_my_name@b {
  name = "DP-My-Name"
  placeholder = "{{dc.dp-my-name}}"
  default_locale_id = zendesk.locale.instance.missing_1
  variants = [
    zendesk.dynamic_content_item__variants.instance.dp_my_name_b__en_US_b@uumuuum,
    zendesk.dynamic_content_item__variants.instance.dp_my_name_b__es@uumuu,
    zendesk.dynamic_content_item__variants.instance.dp_my_name_b__he@uumuu,
    zendesk.dynamic_content_item__variants.instance.dp_my_name_b__fr@uumuu,
  ]
  _alias = "DP-My-Name"
}
