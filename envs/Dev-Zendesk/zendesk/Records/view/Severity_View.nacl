        sortable = true
      },
      {
        id = "assignee"
        title = "Agente asignado"
        filterable = true
        sortable = true
      },
    ]
  }
  conditions = {
    all = [
      {
        field = "status"
        operator = "is"
        value = "new"
      },
      {
        field = "ticket_form_id"
        operator = "is"
        value = zendesk.ticket_form.instance.Severity_Form_@s
      },
    ]
    any = [
      {
        field = "priority"
        operator = "is"
        value = "high"
      },
    ]
  }
  raw_title = "Severity View"
  _alias = "Severity View"
}
