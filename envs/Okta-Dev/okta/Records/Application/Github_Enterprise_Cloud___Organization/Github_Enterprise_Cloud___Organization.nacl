okta.Application Github_Enterprise_Cloud___Organization@sssbs {
  name = "githubcloud"
  label = "Github Enterprise Cloud - Organization"
  status = "INACTIVE"
  accessibility = {
    selfService = false
  }
  visibility = {
    autoLaunch = false
    autoSubmitToolbar = false
    hide = {
      iOS = false
      web = false
    }
  }
  signOnMode = "SAML_2_0"
  credentials = {
    userNameTemplate = {
      template = "\${source.login}"
      type = "BUILT_IN"
    }
  }
  settings = {
    app = {
      githubOrg = "saltozalsso"
    }
    notifications = {
      vpn = {
        network = {
          connection = "DISABLED"
        }
      }
    }
    manualProvisioning = false
    implicitAssignment = false
    notes = {
      admin = ""
      enduser = ""
    }
    signOn = {
      honorForceAuthn = false
      attributeStatements = [
      ]
    }
  }
  _alias = "Github Enterprise Cloud - Organization"
}
