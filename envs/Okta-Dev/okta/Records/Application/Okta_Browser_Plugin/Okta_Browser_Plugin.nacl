okta.Application Okta_Browser_Plugin@s {
  name = "okta_browser_plugin"
  label = "Okta Browser Plugin"
  status = "ACTIVE"
  accessibility = {
    selfService = false
  }
  visibility = {
    autoSubmitToolbar = false
    hide = {
      iOS = true
      web = true
    }
  }
  signOnMode = "OPENID_CONNECT"
  credentials = {
    userNameTemplate = {
      template = "\${source.login}"
      type = "BUILT_IN"
    }
  }
  settings = {
    notifications = {
      vpn = {
        network = {
          connection = "DISABLED"
        }
      }
    }
    manualProvisioning = false
    implicitAssignment = false
  }
  apiScopes = [
    {
      scopeId = "okta.enduser.dashboard.manage"
    },
    {
      scopeId = "okta.enduser.dashboard.read"
    },
    {
      scopeId = "okta.internal.enduser.manage"
    },
    {
      scopeId = "okta.internal.enduser.read"
    },
    {
      scopeId = "okta.personal.authenticator.manage"
    },
    {
      scopeId = "okta.personal.authenticator.read"
    },
    {
      scopeId = "okta.personal.manage"
    },
    {
      scopeId = "okta.personal.read"
    },
    {
      scopeId = "okta.users.read.self"
    },
  ]
  _alias = "Okta Browser Plugin"
}
