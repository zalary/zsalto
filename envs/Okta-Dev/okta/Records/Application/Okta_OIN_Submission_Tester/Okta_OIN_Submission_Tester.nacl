okta.Application Okta_OIN_Submission_Tester@s {
  name = "okta_oin_submission_tester_app"
  label = "Okta OIN Submission Tester"
  status = "ACTIVE"
  accessibility = {
    selfService = false
  }
  visibility = {
    autoSubmitToolbar = false
    hide = {
      iOS = false
      web = false
    }
  }
  signOnMode = "OPENID_CONNECT"
  credentials = {
    userNameTemplate = {
      template = "\${source.login}"
      type = "BUILT_IN"
    }
  }
  settings = {
    notifications = {
      vpn = {
        network = {
          connection = "DISABLED"
        }
      }
    }
    manualProvisioning = false
    implicitAssignment = false
  }
  apiScopes = [
    {
      scopeId = "okta.apps.manage"
    },
    {
      scopeId = "okta.users.manage"
    },
  ]
  _alias = "Okta OIN Submission Tester"
}
