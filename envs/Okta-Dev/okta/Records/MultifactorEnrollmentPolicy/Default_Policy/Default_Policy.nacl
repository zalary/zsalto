okta.MultifactorEnrollmentPolicy Default_Policy@s {
  status = "ACTIVE"
  name = "Default Policy"
  description = "The default policy applies in all situations if no other policy applies."
  system = true
  conditions = {
    people = {
      groups = {
        include = [
          okta.Group.instance.Everyone,
        ]
      }
    }
  }
  settings = {
    factors = {
      okta_otp = {
        enroll = {
          self = "OPTIONAL"
        }
        consent = {
          type = "NONE"
        }
      }
      okta_password = {
        enroll = {
          self = "OPTIONAL"
        }
        consent = {
          type = "NONE"
        }
      }
    }
  }
  type = "MFA_ENROLL"
  _alias = "Default Policy"
}
