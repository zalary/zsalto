okta.Feature Enforce_MFA_for_admin_only_Identity_Governance_apps@sssbsss {
  type = "self-service"
  status = "DISABLED"
  name = "Enforce MFA for admin-only Identity Governance apps"
  description = "This feature makes MFA mandatory to access admin-only Identity Governance apps. In Identity Engine, the Admin App Policy applies to these Identity Governance apps. In Classic Engine, any authentication policy rules that protect these Identity Governance apps are updated from single-factor to 2-factor. If you disable this feature, the changes are not automatically reverted. You must manually edit the rules to allow single-factor access."
  stage = {
    value = "EA"
  }
  _alias = "Enforce MFA for admin-only Identity Governance apps"
}
