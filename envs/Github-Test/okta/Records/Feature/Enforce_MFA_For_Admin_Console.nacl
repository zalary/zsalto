okta.Feature Enforce_MFA_For_Admin_Console@s {
  type = "self-service"
  status = "DISABLED"
  name = "Enforce MFA For Admin Console"
  description = "This feature requires multi-factor authentication to access the Okta admin console. It automatically updates any single-factor rules that protect the Okta admin console to multi-factor. Note - once rules are automatically updated, they are not reverted when this feature is disabled. "
  stage = {
    value = "EA"
  }
  _alias = "Enforce MFA For Admin Console"
}
