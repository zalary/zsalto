zendesk {
  fixElements = { deployArticlesAsDraft = true } 
  fetch = {
        guide = {
       brands = [".*"]
      }
    include = [
      {
        type = ".*"
      },
    ]
    elemID = {
      article_attachment = {
        parts = [
          {
            fieldName = "file_name"
          },
          {
            fieldName = "inline"
          },
          {
            fieldName = "locale"
          },
        ]
      }
  }
    exclude = [
      {
        type = "oauth_global_client"
      },
       {
        type     = "ticket_form"
        criteria = { name = "ZGY.*" }
      }
    ]
    resolveOrganizationIDs = true
    omitInactive = {
      default = true
    }
  }
    deploy = {
      defaultMissingUserFallback = "##DEPLOYER##" 
      changeValidators = {
      orderInstanceContainsAllTheInstances = false
    }
  } 
}
