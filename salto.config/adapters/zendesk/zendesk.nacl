zendesk {
  fetch = {
    omitInactive = {
      default = true
      customizations = {
        trigger = false
      }
    }
    guide = {
       brands = ["^Salto"]
      }
    include = [
      {
        type = ".*"
      },

    ]
    exclude = [
      {
        type = "oauth_global_client"
      },
    ]
    resolveOrganizationIDs = true
  }
}