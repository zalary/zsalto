zendesk {
  fixElements = { deployArticlesAsDraft = true } 
  fetch = {
    omitInactive = {
      default = true
      customizations = {
        trigger = false
      }
    }
    guide = {
       brands = [".*"]
      }
    include = [
      {
        type = ".*"
      }
    ]
    exclude = [
      {
        type = "oauth_global_client"
      }
    ]
    resolveOrganizationIDs = true
  }
}