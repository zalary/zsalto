zendesk {
  fixElements = { deployArticlesAsDraft = true } 
  fetch = {
        guide = {
       brands = [".*"]
      }
    include = [
      {
        type = ".*"
      },
    ]
    elemID = {
      article_attachment = {
        parts = [
          {
            fieldName = "file_name"
          },
          {
            fieldName = "inline"
          },
          {
            fieldName = "locale"
          },
        ]
      }
  }
    exclude = [
      {
        type = "oauth_global_client"
      },
    ]
    resolveOrganizationIDs = true
  }
}
